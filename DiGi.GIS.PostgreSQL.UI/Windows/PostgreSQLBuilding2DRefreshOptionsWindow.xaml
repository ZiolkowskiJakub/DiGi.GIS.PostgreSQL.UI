<Window x:Class="DiGi.GIS.PostgreSQL.UI.Windows.PostgreSQLBuilding2DRefreshOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiGi.GIS.PostgreSQL.UI.Windows"
        xmlns:controls="clr-namespace:DiGi.UI.WPF.Controls;assembly=DiGi.UI.WPF"
        mc:Ignorable="d"
        Title="Refresh Building2Ds" Height="560" Width="560" MinHeight="440" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Icon="pack://application:,,,/DiGi.GIS.PostgreSQL.UI;component/Resources/DiGi.GIS.ico">
    <Grid Margin="5,5,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
            <RowDefinition Height="33" />
        </Grid.RowDefinitions>

        <controls:TextBoxControl x:Name="TextBoxControl_BatchSize" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Batch size - buildings locked and written per transaction" Value="" />

        <CheckBox x:Name="CheckBox_OverrideExistingSubdivisionIds" Grid.Row="1" Content="Override existing subdivision ids - re-derive every building, not only the ones without one" Margin="10,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <CheckBox x:Name="CheckBox_NestedSubdivisionsOnly" Grid.Row="2" Content="Nested subdivision layers only - counties where a subdivision lies inside another" ToolTip="Limits the run to the counties whose subdivision layer nests, where the previous tie-break produced an arbitrary subdivision_id - nearly all of them, since a village and its named parts nest as a city and its districts do. Combined with a county selection, only the selected counties that also nest are refreshed." Margin="10,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <Label x:Name="Label_Counties" Grid.Row="3" Content="Counties - none selected means every county; a multi-part county is one entry per piece" Margin="5,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

        <controls:ListBoxControl x:Name="ListBoxControl_Counties" Grid.Row="4" SelectionMode="Extended" Margin="10,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5">
            <Button x:Name="Button_OK" Content="OK" Width="70" Height="23" Margin="5,0,5,0" IsDefault="True" Click="Button_OK_Click" />
            <Button x:Name="Button_Cancel" Content="Cancel" Width="70" Height="23" Margin="5,0,5,0" IsCancel="True" Click="Button_Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
