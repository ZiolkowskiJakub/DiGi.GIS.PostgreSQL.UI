<Window x:Class="DiGi.GIS.PostgreSQL.UI.Windows.PostgreSQLBuildingModelBuildingInformationUpdateOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiGi.GIS.PostgreSQL.UI.Windows"
        xmlns:controls="clr-namespace:DiGi.UI.WPF.Controls;assembly=DiGi.UI.WPF"
        mc:Ignorable="d"
        Title="Stamp BuildingInformation" Height="660" Width="560" MinHeight="460" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Icon="pack://application:,,,/DiGi.GIS.PostgreSQL.UI;component/Resources/DiGi.GIS.ico">
    <Grid Margin="5,5,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="33" />
        </Grid.RowDefinitions>

        <Label x:Name="Label_Counties" Grid.Row="0" Content="Counties - a multi-part county is one entry per piece; select them all" Margin="5,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

        <controls:ListBoxControl x:Name="ListBoxControl_Counties" Grid.Row="1" SelectionMode="Extended" Margin="10,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Grid Grid.Row="2" Margin="10,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label x:Name="Label_DetailLevel" Grid.Row="0" Content="Detail level - All walks every level whose table exists" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            <ComboBox x:Name="ComboBox_DetailLevel" Grid.Row="1" VerticalAlignment="Center" SelectedIndex="0">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Component" />
                <ComboBoxItem Content="Envelope" />
            </ComboBox>
        </Grid>

        <controls:TextBoxControl x:Name="TextBoxControl_BatchSize" Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Batch size - models read and classified per page" Value="" />

        <controls:TextBoxControl x:Name="TextBoxControl_CommandTimeout" Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Command timeout in seconds - 0 disables it" Value="" />

        <controls:TextBoxControl x:Name="TextBoxControl_ReportDirectory" Grid.Row="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Report directory - the checkpoint and the reports are written here" Value="" />

        <CheckBox x:Name="CheckBox_Resume" Grid.Row="6" Content="Resume from the checkpoint - skip the parts an earlier run finished" Margin="10,0,10,0" VerticalAlignment="Center" />

        <CheckBox x:Name="CheckBox_DryRun" Grid.Row="7" Content="Dry run - report what would be stamped, write nothing" Margin="10,0,10,0" VerticalAlignment="Center" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5">
            <Button x:Name="Button_OK" Content="OK" Width="70" Height="23" Margin="5,0,5,0" IsDefault="True" Click="Button_OK_Click" />
            <Button x:Name="Button_Cancel" Content="Cancel" Width="70" Height="23" Margin="5,0,5,0" IsCancel="True" Click="Button_Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
