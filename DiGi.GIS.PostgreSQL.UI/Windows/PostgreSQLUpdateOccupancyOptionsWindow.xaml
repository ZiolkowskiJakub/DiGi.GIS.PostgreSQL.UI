<Window x:Class="DiGi.GIS.PostgreSQL.UI.Windows.PostgreSQLUpdateOccupancyOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiGi.GIS.PostgreSQL.UI.Windows"
        xmlns:controls="clr-namespace:DiGi.UI.WPF.Controls;assembly=DiGi.UI.WPF"
        mc:Ignorable="d"
        Title="Update occupancy" Height="540" Width="560" MinHeight="420" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Icon="pack://application:,,,/DiGi.GIS.PostgreSQL.UI;component/Resources/DiGi.GIS.ico">
    <Grid Margin="5,5,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
            <RowDefinition Height="33" />
        </Grid.RowDefinitions>

        <CheckBox x:Name="CheckBox_IncludeAdministrativeAreal2Ds" Grid.Row="0" Content="Administrative areas - the roll-up from subdivision to country, always nationwide" Margin="10,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <CheckBox x:Name="CheckBox_IncludeBuilding2Ds" Grid.Row="1" Content="Buildings - each subdivision's figure distributed over its buildings" Margin="10,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <CheckBox x:Name="CheckBox_Clear" Grid.Row="2" Content="Clear first - the whole table, or with counties selected only their buildings' rows" Margin="10,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <Label x:Name="Label_Counties" Grid.Row="3" Content="Counties for the building side - none selected means every county; one entry per piece" ToolTip="A multi-part county is one entry per polygon piece; select them all to cover the county." Margin="5,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

        <controls:ListBoxControl x:Name="ListBoxControl_Counties" Grid.Row="4" SelectionMode="Extended" Margin="10,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5">
            <Button x:Name="Button_OK" Content="OK" Width="70" Height="23" Margin="5,0,5,0" IsDefault="True" Click="Button_OK_Click" />
            <Button x:Name="Button_Cancel" Content="Cancel" Width="70" Height="23" Margin="5,0,5,0" IsCancel="True" Click="Button_Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
